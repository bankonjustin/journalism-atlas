# Cloudflare Pages response headers. Nodes and Networks interactive edition (unlisted until launch).
/preview/nodes-and-networks-edition-e852c5c5/*
  X-Robots-Tag: noindex, nofollow
/preview/nodes-and-networks-edition-e852c5c5/embed/*
  Content-Security-Policy: frame-ancestors *
/assets/nn5/*
  Cache-Control: public, max-age=600
/assets/nn5/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Partner page template (not a public page; copying it must not carry noindex, so it is set here, not in the file).
